{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BundleDef",
  "description": "One gem bundle (docs/26 section 3). Generated by Tools/content_cli/gen_bundles.py. Every bundle holds one hidden hero card (hiddenCard true, docs/37); the hero is drawn at purchase.",
  "type": "object",
  "required": ["id", "name", "tier", "priceGems", "coins", "powerups", "hiddenCard"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^bnd_[0-9]{4}$"},
    "name": {"type": "string", "minLength": 3},
    "tier": {"type": "integer", "minimum": 1, "maximum": 3},
    "priceGems": {"type": "integer", "minimum": 200, "maximum": 600},
    "coins": {"type": "integer", "minimum": 0},
    "powerups": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "count"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "enum": ["pw_flight", "pw_rocket", "pw_doublejump", "pw_wallstick", "pw_shield", "pw_magnet", "pw_slowtime"]},
          "count": {"type": "integer", "minimum": 1, "maximum": 10}
        }
      }
    },
    "hiddenCard": {"type": "boolean", "enum": [true]}
  }
}
