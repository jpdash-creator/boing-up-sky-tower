{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GemPackDef",
  "type": "object",
  "required": ["id", "gems", "usdList", "usdPromo", "inrList", "firstPurchaseDouble", "sku", "badge"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^gempack_[a-z0-9_]+$"},
    "gems": {"type": "integer", "minimum": 1},
    "usdList": {"type": "number", "minimum": 0.49},
    "usdPromo": {"type": "number", "minimum": 0.49},
    "inrList": {"type": "integer", "minimum": 1},
    "firstPurchaseDouble": {"type": "boolean"},
    "sku": {"type": "string", "pattern": "^com[.]jdlabs[.]fluffyclimbers[.]gems[.]pack_[0-9]+$"},
    "badge": {"type": "string", "enum": ["", "popular", "best_value"]}
  }
}
