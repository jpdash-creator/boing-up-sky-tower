{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GemPackDef",
  "type": "object",
  "required": ["id", "gems", "usdList", "usdPromo", "sku", "badge"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^gempack_[a-z0-9_]+$"},
    "gems": {"type": "integer", "minimum": 1},
    "usdList": {"type": "number", "minimum": 0.49},
    "usdPromo": {"type": "number", "minimum": 0.49},
    "sku": {"type": "string", "pattern": "^skyhopper[.]gems[.][a-z0-9_]+$"},
    "badge": {"type": "string", "enum": ["", "popular", "best_value"]}
  }
}
