{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LevelDef",
  "type": "object",
  "required": ["id", "region", "index", "seed", "class", "difficulty", "goal", "rewards"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^lvl_[0-9]{3}_[0-9]{2}$"},
    "region": {"type": "string", "pattern": "^region_[0-9]{3}_[a-z0-9_]+$"},
    "index": {"type": "integer", "minimum": 1, "maximum": 25},
    "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "class": {"type": "string", "enum": ["simple", "medium", "hard", "complex", "highly_complex"]},
    "difficulty": {"type": "number", "minimum": 0, "maximum": 1},
    "goal": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "enum": ["reachFloor", "collectCoins", "comboChain", "noWallBounce", "findHiddenGem", "speedrun", "surviveWave", "bossChase"]},
        "value": {"type": "integer", "minimum": 1},
        "count": {"type": "integer", "minimum": 1},
        "timeSec": {"type": "integer", "minimum": 1}
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fixedChunks": {"type": "array", "items": {"type": "string"}},
        "ramp": {"type": "boolean"}
      }
    },
    "rewards": {
      "type": "object",
      "required": ["gems"],
      "additionalProperties": false,
      "properties": {
        "gems": {
          "type": "object",
          "required": ["chance", "min", "max"],
          "additionalProperties": false,
          "properties": {
            "chance": {"type": "number", "minimum": 0, "maximum": 1},
            "min": {"type": "integer", "minimum": 0},
            "max": {"type": "integer", "minimum": 0},
            "firstClearGuaranteed": {"type": "integer", "minimum": 0},
            "starBonusMax": {"type": "integer", "minimum": 0},
            "replayChance": {"type": "number", "minimum": 0, "maximum": 1},
            "replayAmount": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  }
}
