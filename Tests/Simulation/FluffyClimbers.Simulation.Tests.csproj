<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiles the engine-agnostic Simulation sources straight from Assets/ so Unity and the tests share one code base.
       LangVersion 9 matches Unity 6, so anything that builds here builds in Unity. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>FluffyClimbers.Simulation.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/_Game/Simulation/**/*.cs" />
    <!-- Economy tier data is pure C# (Simulation types only), so the tier rules and rows are tested here too -->
    <Compile Include="../../Assets/_Game/Economy/HeroTable.cs" />
    <Compile Include="../../Assets/_Game/Economy/HeroVariants.cs" />
    <Compile Include="../../Assets/_Game/Economy/HeroRolls.cs" />
    <Compile Include="../../Assets/_Game/Economy/TierRules.cs" />
    <Compile Include="../../Assets/_Game/Economy/MergeTierDefs.cs" />
    <Compile Include="../../Assets/_Game/Economy/Characters.cs" />
    <Compile Include="../../Assets/_Game/Economy/AdminGate.cs" />
    <Compile Include="../../Assets/_Game/Economy/BundleCards.cs" />
    <Compile Include="../../Assets/_Game/Economy/HeroPurchase.cs" />
    <Compile Include="../../Assets/_Game/Economy/ChestCards.cs" />
    <Compile Include="../../Assets/_Game/Economy/CharacterInventory.cs" />
    <Compile Include="../../Assets/_Game/Economy/RewardEntry.cs" />
    <Compile Include="../../Assets/_Game/Economy/RegionGoals.cs" />
    <Compile Include="../../Assets/_Game/Economy/MergeRules.cs" />
    <Compile Include="../../Assets/_Game/Economy/HeroCards.cs" />
    <Compile Include="../../Assets/_Game/Economy/AllHeroes.cs" />
    <!-- timed records (doc 46): pure maths and rules; the data classes use Newtonsoft attributes (testhost brings the package) -->
    <Compile Include="../../Assets/_Game/Economy/TimeRecords.cs" />
    <Compile Include="../../Assets/_Game/Economy/TimeRecordData.cs" />
    <Compile Include="../../Assets/_Game/Economy/MedalTargetFile.cs" />
    <Compile Include="../../Assets/_Game/Economy/CrownScore.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
